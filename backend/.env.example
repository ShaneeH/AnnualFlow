PORT=3000
NODE_ENV=development

# PostgreSQL connection string. Hosted providers usually need ?sslmode=require.
DATABASE_URL=postgres://postgres:replace_me@localhost:5432/senus

OPENAI_API_KEY=replace_me
OPENAI_MODEL=gpt-5
OPENAI_TIMEOUT_MS=180000

# Comma-separated browser origins. CLI clients without an Origin header still work.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Set true only when Express is behind a trusted single reverse proxy.
TRUST_PROXY=false
MAX_PDF_SIZE_MB=20


# Upload processing: "async" queues a background job (needs a long-running host:
# local, Render, Railway, Fly, a VM). "sync" processes inside the request.
# Default: sync when VERCEL is set (serverless), async otherwise.
# JOB_MODE=async
